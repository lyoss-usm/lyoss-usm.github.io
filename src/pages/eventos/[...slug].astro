---
/*
 * Pagina de detalle de un evento. El frontmatter alimenta la cabecera y el
 * cuerpo en MDX trae lo que se redacta por evento: cronograma, bases, tema de
 * la clase, FAQ. Agregar un evento es agregar un .mdx, sin tocar este archivo.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import Cabecera from '@/components/evento/Cabecera.astro';
import Relacionados from '@/components/evento/Relacionados.astro';
import { aEvento, calcularEstado, type EventoConEstado } from '@/utils/eventos';

export async function getStaticPaths() {
	const entradas = await getCollection('eventos');

	// El id del glob ya trae la carpeta cuando el evento va en una subcarpeta
	// (taller-de-git/clase-1), por eso la ruta es [...slug] y no [slug]
	return entradas.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'eventos'> };

const { entry } = Astro.props;

const evento = aEvento(entry);
const estado = calcularEstado(evento.fechaInicio, evento.fechaFin);
const { Content } = await render(entry);

// La agenda completa se pasa completa para poder listar los eventos de la serie
const agenda: EventoConEstado[] = (await getCollection('eventos')).map(aEvento).map((evento) => ({
	evento,
	estado: calcularEstado(evento.fechaInicio, evento.fechaFin)
}));
---

<MainLayout title={`${evento.titulo} | Lyoss`} description={evento.descripcion}>
	<Cabecera evento={evento} estado={estado} />

	<section class="bg-base-100 pb-16">
		<div
			class="container mx-auto max-w-4xl px-4 [&_a]:link [&_a]:text-primary [&_blockquote]:my-4 [&_blockquote]:border-l-4 [&_blockquote]:border-base-content/20 [&_blockquote]:py-1 [&_blockquote]:pl-4 [&_code]:rounded [&_code]:bg-base-200 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-sm [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:font-heading [&_h2]:text-2xl [&_h2]:font-bold [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:font-heading [&_h3]:text-xl [&_h3]:font-bold [&_li]:ml-5 [&_li]:leading-relaxed [&_ol]:my-4 [&_ol]:ml-5 [&_ol]:list-decimal [&_ol]:pl-1 [&_p]:my-4 [&_p]:leading-relaxed [&_p]:text-base-content/80 [&_strong]:font-semibold [&_strong]:text-base-content [&_table]:my-4 [&_table]:w-full [&_table]:text-left [&_td]:border-b [&_td]:border-base-content/10 [&_td]:py-2 [&_th]:border-b [&_th]:border-base-content/20 [&_th]:py-2 [&_ul]:my-4 [&_ul]:ml-5 [&_ul]:list-disc [&_ul]:pl-1 [&>*+*]:mt-4"
		>
			<Content />
		</div>
	</section>

	<Relacionados evento={evento} agenda={agenda} />
</MainLayout>

<script>
	import { ESTADOS_EVENTO, calcularEstado } from '@/utils/eventos';

	/*
	 * El build resuelve el estado con su propia fecha, pero un sitio estatico
	 * puede quedar publicado con el evento ya vencido. Con la hora de quien
	 * visita se repintan los badges y se apagan los eventos vencidos, igual que
	 * en el calendario y en la alerta.
	 */
	document.querySelectorAll<HTMLElement>('[data-evento]').forEach((bloque) => {
		const inicio = bloque.dataset.inicio;
		if (!inicio) return;

		const estado = calcularEstado(
			new Date(inicio),
			bloque.dataset.fin ? new Date(bloque.dataset.fin) : undefined
		);

		const badge = bloque.querySelector<HTMLElement>('[data-estado]');
		if (!badge) return;

		Object.values(ESTADOS_EVENTO).forEach((otro) => badge.classList.remove(otro.badge));
		badge.classList.add(ESTADOS_EVENTO[estado].badge);
		badge.textContent = ESTADOS_EVENTO[estado].label;

		// Solo se apagan los bloques marcados con data-atenuar. La cabecera de la ficha
		// no lo lleva: tiene que seguir legible aunque el evento ya haya pasado.
		if (bloque.hasAttribute('data-atenuar')) {
			bloque.classList.toggle('evento-finalizado', estado === 'finalizado');
		}
	});
</script>
