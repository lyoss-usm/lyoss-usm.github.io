		tipo: 'hackaton',
		serie: undefined,
		fechaInicio: fecha('2026-11-13 18:00'),
		fechaFin: fecha('2026-11-15 14:00'),
		ubicacion: 'Por definir · USM',
		descripcion:
			'Fin de semana de programación en equipo para desarrollar open source. Cronograma, categorías y premios en la landing.',
