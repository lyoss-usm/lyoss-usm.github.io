---
/*
 * Calendario de eventos con datos de la colección 'eventos'.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import Encabezado from '@/components/calendario/Encabezado.astro';
import Controles from '@/components/calendario/Controles.astro';
import Agenda from '@/components/calendario/Agenda.astro';
import Rejilla from '@/components/calendario/Rejilla.astro';
import Vacio from '@/components/calendario/Vacio.astro';
import { getCollection } from 'astro:content';
import {
	TIPOS_EVENTO,
	calcularEstado,
	aEvento,
	formatearMesAnio,
	type TipoEvento
} from '@/utils/eventos';
import { agruparPorMes, construirMeses } from '@/utils/calendario';

const entradas = await getCollection('eventos');
const eventos = entradas
	.map(aEvento)
	.sort((a, b) => a.fechaInicio.getTime() - b.fechaInicio.getTime());

const agenda = eventos.map((evento) => ({
	evento,
	estado: calcularEstado(evento.fechaInicio, evento.fechaFin)
}));

// Si la coleccion llega vacia, se decide aqui y no en el navegador: el build
// entrega el estado vacio ya visible, sin depender de un primer clic
const hayEventos = eventos.length > 0;

const grupos = agruparPorMes(agenda);
const meses = construirMeses(agenda, grupos);

const tiposPresentes = (Object.keys(TIPOS_EVENTO) as TipoEvento[]).filter((tipo) =>
	eventos.some((evento) => evento.tipo === tipo)
);

// El periodo del resumen sale de los propios eventos, no de meses escritos a mano
const primero = eventos[0]?.fechaInicio;
const ultimo = eventos.at(-1)?.fechaInicio;
let resumen = 'eventos por confirmar · agenda y mes a la vista';
if (primero && ultimo) {
	const desde = formatearMesAnio(primero);
	const hasta = formatearMesAnio(ultimo);
	const periodo = desde === hasta ? desde : `${desde.toLowerCase()} a ${hasta.toLowerCase()}`;
	resumen = `eventos de ${periodo} · agenda y mes a la vista`;
}
---

<MainLayout title="Calendario | Lyoss" description="Todos los eventos de Lyoss en un solo lugar">
	<div class="min-h-screen bg-base-100 pt-20">
		<div class="container mx-auto px-4 py-8">
			<Encabezado total={eventos.length} resumen={resumen} />
			<Controles tipos={tiposPresentes} />
			<Vacio
				id="calendario-vacio"
				titulo="Todavia no hay eventos en el calendario"
				detalle="Cuando carguemos las fechas te avisamos por aqui."
				conAccion={hayEventos}
				oculto={hayEventos}
				clas="mb-8"
			/>
			<Agenda grupos={grupos} oculto={!hayEventos} />
			<Rejilla meses={meses} oculto={!hayEventos} />
		</div>
	</div>

	<script>
		import { ESTADOS_EVENTO, TIPOS_EVENTO, calcularEstado, type TipoEvento } from '@/utils/eventos';

		// Estado real: se calcula con la fecha de quien visita
		const clasesEstado = Object.values(ESTADOS_EVENTO).map((estado) => estado.badge);

		const pintarEstados = (raiz: ParentNode) => {
			raiz.querySelectorAll<HTMLElement>('[data-estado]').forEach((elemento) => {
				const contenedor = elemento.closest<HTMLElement>('[data-inicio]');
				if (!contenedor) return;
				const inicio = contenedor.dataset.inicio;
				const fin = contenedor.dataset.fin;
				if (!inicio) return;

				const estado = calcularEstado(new Date(inicio), fin ? new Date(fin) : undefined);
				elemento.dataset.estado = estado;
				// Se limpian las clases de estado anteriores: si el markup ya traia una,
				// se quedaria pegada junto a la nueva y ganaria la que llegue ultima en el CSS
				clasesEstado.forEach((clase) => elemento.classList.remove(clase));
				elemento.classList.add(ESTADOS_EVENTO[estado].badge);
				elemento.textContent = ESTADOS_EVENTO[estado].label;
				contenedor.classList.toggle('evento-finalizado', estado === 'finalizado');
			});
		};
		pintarEstados(document);

		// Vista agenda / rejilla, y el estado vacio que las reemplaza
		const botonesVista = document.querySelectorAll<HTMLButtonElement>('.cambiar-vista');
		const agenda = document.getElementById('vista-agenda');
		const rejilla = document.getElementById('vista-rejilla');
		const bloqueVacio = document.getElementById('calendario-vacio');
		const itemsAgenda = document.querySelectorAll<HTMLElement>('.evento');
		let vistaActiva: 'agenda' | 'rejilla' = 'agenda';
		let tipoActivo = 'todos';

		const visible = (elemento: HTMLElement) => !elemento.classList.contains('hidden');
		const sinResultados = () => !Array.from(itemsAgenda).some(visible);

		const pintarVistas = () => {
			const vacio = sinResultados();
			bloqueVacio?.toggleAttribute('hidden', !vacio);

			if (vacio && bloqueVacio) {
				const quitar = bloqueVacio.querySelector('[data-quitar-filtro]');
				const titulo = bloqueVacio.querySelector('[data-vacio-titulo]');
				const detalle = bloqueVacio.querySelector('[data-vacio-detalle]');
				const filtrando = tipoActivo !== 'todos';

				if (titulo) {
					titulo.textContent = filtrando
						? `No hay eventos de tipo ${TIPOS_EVENTO[tipoActivo as TipoEvento].label}`
						: 'Todavia no hay eventos en el calendario';
				}
				if (detalle) {
					detalle.textContent = filtrando
						? 'Quita el filtro para volver a ver todos los eventos.'
						: 'Cuando carguemos las fechas te avisamos por aqui.';
				}
				quitar?.toggleAttribute('hidden', !filtrando);
			}

			agenda?.classList.toggle('hidden', vacio || vistaActiva !== 'agenda');
			rejilla?.classList.toggle('hidden', vacio || vistaActiva !== 'rejilla');
		};

		botonesVista.forEach((boton) => {
			boton.addEventListener('click', () => {
				vistaActiva = boton.dataset.vista === 'rejilla' ? 'rejilla' : 'agenda';
				botonesVista.forEach((otro) => {
					const activo = otro === boton;
					otro.setAttribute('aria-pressed', String(activo));
					otro.classList.toggle('btn-primary', activo);
					otro.classList.toggle('btn-outline', !activo);
				});
				pintarVistas();
			});
		});

		// Navegacion entre meses: se recorren todos, incluso los que no tienen eventos
		const bloques = Array.from(document.querySelectorAll<HTMLElement>('.mes-rejilla'));
		const botonesAnterior = document.querySelectorAll<HTMLButtonElement>('.mes-anterior');
		const botonesSiguiente = document.querySelectorAll<HTMLButtonElement>('.mes-siguiente');
		let mesActual = 0;

		const pintarMes = () => {
			mesActual = Math.min(Math.max(mesActual, 0), Math.max(bloques.length - 1, 0));
			// Se ocultan todos los bloques y se revela solo el mes actual
			bloques.forEach((bloque, indice) => {
				bloque.hidden = indice !== mesActual;
			});
			botonesAnterior.forEach((boton) => (boton.disabled = mesActual === 0));
			botonesSiguiente.forEach((boton) => (boton.disabled = mesActual === bloques.length - 1));
		};

		const moverMes = (delta: number) => {
			const destino = mesActual + delta;
			if (destino < 0 || destino >= bloques.length) return;
			mesActual = destino;
			pintarMes();
		};

		// Cada mes trae su propio par de botones, asi que se escuchan por delegacion
		rejilla?.addEventListener('click', (evento) => {
			const boton = (evento.target as HTMLElement).closest<HTMLButtonElement>(
				'.mes-anterior, .mes-siguiente'
			);
			if (!boton || boton.disabled) return;
			moverMes(boton.classList.contains('mes-anterior') ? -1 : 1);
		});
		pintarMes();

		// Detalle del dia: bajo sm el chip no es un link, asi que la celda completa
		// es un boton que clona la plantilla del dia en el dialog
		const modalDia = document.getElementById('dia-modal') as HTMLDialogElement | null;
		const modalTitulo = document.getElementById('dia-modal-titulo');
		const modalCuerpo = document.getElementById('dia-modal-cuerpo');

		rejilla?.addEventListener('click', (evento) => {
			const boton = (evento.target as HTMLElement).closest<HTMLButtonElement>('.abrir-dia');
			const plantilla = boton?.parentElement?.querySelector<HTMLTemplateElement>('.plantilla-dia');
			if (!boton || !plantilla || !modalDia || !modalCuerpo) return;

			modalCuerpo.replaceChildren(plantilla.content.cloneNode(true));
			modalCuerpo.querySelectorAll<HTMLElement>('[data-tipo]').forEach((item) => {
				item.classList.toggle('hidden', tipoActivo !== 'todos' && item.dataset.tipo !== tipoActivo);
			});
			if (modalTitulo) modalTitulo.textContent = boton.dataset.titulo ?? '';
			pintarEstados(modalCuerpo);
			modalDia.showModal();
		});

		modalDia?.addEventListener('click', (evento) => {
			if ((evento.target as HTMLElement).closest('[data-cerrar-dia]')) modalDia.close();
		});

		// Filtro por tipo: afecta a la agenda, a los chips de la rejilla y a los meses sin eventos
		const botonesFiltro = document.querySelectorAll<HTMLButtonElement>('.filtro-tipo');
		const chips = document.querySelectorAll<HTMLElement>('.evento-chip');
		const botonesDia = document.querySelectorAll<HTMLButtonElement>('.abrir-dia');
		const contador = document.getElementById('evento-count');

		const aplicarFiltro = () => {
			const coincide = (elemento: HTMLElement) =>
				tipoActivo === 'todos' || elemento.dataset.tipo === tipoActivo;

			itemsAgenda.forEach((item) => item.classList.toggle('hidden', !coincide(item)));
			chips.forEach((chip) => chip.classList.toggle('hidden', !coincide(chip)));

			// Agenda y rejilla comparten el mismo estado vacio por mes: si el filtro
			// deja el mes sin nada, se avisa en vez de desaparecer en silencio.
			// En la agenda los items son .evento y en la rejilla .evento-chip
			const etiqueta = tipoActivo === 'todos' ? null : TIPOS_EVENTO[tipoActivo as TipoEvento].label;
			document.querySelectorAll<HTMLElement>('.mes-agenda, .mes-rejilla').forEach((bloque) => {
				const quedan = Array.from(
					bloque.querySelectorAll<HTMLElement>('.evento, .evento-chip')
				).some(visible);
				bloque.querySelector<HTMLElement>('[data-items-mes]')?.toggleAttribute('hidden', !quedan);

				const aviso = bloque.querySelector<HTMLElement>('[data-mes-vacio]');
				aviso?.toggleAttribute('hidden', quedan);
				if (!aviso || quedan) return;
				const titulo = aviso.querySelector('[data-vacio-titulo]');
				const detalle = aviso.querySelector('[data-vacio-detalle]');
				const nombre = bloque.dataset.mesNombre ?? '';
				if (titulo) {
					titulo.textContent = etiqueta
						? `No hay eventos de tipo ${etiqueta} en ${nombre}`
						: `No hay eventos en ${nombre}`;
				}
				if (detalle) {
					detalle.textContent = etiqueta
						? 'Quita el filtro o prueba con otro tipo de evento.'
						: 'No hay eventos en este mes por ahora.';
				}
				aviso.querySelector('[data-quitar-filtro]')?.toggleAttribute('hidden', !etiqueta);
			});

			// El boton de dia solo queda activo si ese dia conserva algun evento visible
			botonesDia.forEach((boton) => {
				const chipsDelDia = boton.parentElement?.querySelectorAll<HTMLElement>('.evento-chip');
				boton.hidden = !chipsDelDia || !Array.from(chipsDelDia).some(visible);
			});

			if (contador) {
				contador.textContent = String(Array.from(itemsAgenda).filter(visible).length);
			}
			pintarVistas();
		};

		const aplicarTipo = (tipo: string) => {
			tipoActivo = tipo;
			botonesFiltro.forEach((boton) => {
				const activo = boton.dataset.tipo === tipo;
				boton.setAttribute('aria-pressed', String(activo));
				boton.classList.toggle('btn-outline', !activo);
				if (boton.dataset.clase) boton.classList.toggle(boton.dataset.clase, activo);
			});
			aplicarFiltro();
		};

		botonesFiltro.forEach((boton) => {
			boton.addEventListener('click', () => aplicarTipo(boton.dataset.tipo ?? 'todos'));
		});
		// El build ya entrego el estado inicial, aqui solo se sincroniza por si el
		// HTML se regenero con datos distintos a los que pinto el servidor
		aplicarFiltro();
		document.querySelectorAll('[data-quitar-filtro]').forEach((boton) => {
			boton.addEventListener('click', () => aplicarTipo('todos'));
		});
	</script>
</MainLayout>
