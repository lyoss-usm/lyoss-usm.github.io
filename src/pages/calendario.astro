---
/*
 * PROTOTIPO de /calendario con datos mock inline.
 * Sirve para revisar el diseño antes de conectar la colección de eventos.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import Encabezado from '@/components/calendario/Encabezado.astro';
import Controles from '@/components/calendario/Controles.astro';
import Agenda from '@/components/calendario/Agenda.astro';
import Rejilla from '@/components/calendario/Rejilla.astro';
import {
	TIPOS_EVENTO,
	calcularEstado,
	interpretarFecha,
	type Evento,
	type TipoEvento
} from '@/utils/eventos';
import { agruparPorMes, construirMeses } from '@/utils/calendario';

const fecha = (valor: string) => interpretarFecha(valor) as Date;

/* DATOS MOCK: se reemplazan por getCollection('eventos') */

const eventosMock: Evento[] = [
