---
import { ArrowRight, ChevronLeft, ChevronRight } from '@lucide/astro';
import {
	MAX_CHIPS_CELDA,
	NOMBRES_DIAS,
	fechaDeClave,
	type MesCalendario
} from '@/utils/calendario';
import {
	ESTADOS_EVENTO,
	TIPOS_EVENTO,
	formatearDiaLargo,
	formatearRangoFechas
} from '@/utils/eventos';
import ChipEvento from './ChipEvento.astro';

type Props = {
	mes: MesCalendario;
	indice: number;
};

const { mes, indice } = Astro.props;
---

<section class="mes-rejilla" data-mes={indice} hidden={indice > 0}>
	<div class="mb-4 flex items-center justify-between">
		<button class="mes-anterior btn btn-circle btn-ghost btn-sm" aria-label="Mes anterior">
			<ChevronLeft class="h-5 w-5" />
		</button>
		<h2 class="font-heading text-2xl font-bold text-base-content" aria-live="polite">
			{mes.nombre}
		</h2>
		<button class="mes-siguiente btn btn-circle btn-ghost btn-sm" aria-label="Mes siguiente">
			<ChevronRight class="h-5 w-5" />
		</button>
	</div>

	<div class="overflow-x-auto">
		<div
			class="grid grid-cols-7 gap-px overflow-hidden rounded-2xl border border-base-content/10 bg-base-content/10"
		>
			{
				NOMBRES_DIAS.map((dia) => (
					<div class="bg-base-200 py-2 text-center text-xs font-semibold tracking-wide text-base-content/60 uppercase">
						{dia}
					</div>
				))
			}

			{
				mes.celdas.map((celda) => {
					const conEventos = celda.eventos.length > 0;
					const etiqueta =
						celda.clave && conEventos ? formatearDiaLargo(fechaDeClave(celda.clave)) : '';
					const chips = celda.eventos.slice(0, MAX_CHIPS_CELDA);
					const restantes = celda.eventos.length - chips.length;

					return (
						<div
							class="relative min-h-24 bg-base-100 p-1.5 sm:min-h-28"
							class:list={[celda.delMesVecino && 'bg-base-200/40 text-base-content/40']}
						>
							{/* Tap en toda la celda bajo 400px, donde el chip es solo un punto */}
							{conEventos && (
								<button
									type="button"
									class="abrir-dia absolute inset-0 block sm:hidden"
									aria-haspopup="dialog"
									aria-label={`Ver ${celda.eventos.length} ${celda.eventos.length === 1 ? 'evento' : 'eventos'} del ${etiqueta.toLowerCase()}`}
									data-titulo={etiqueta}
								/>
							)}

							<span class="mb-1 block px-1 text-xs">{celda.numero}</span>

							<div class="pointer-events-none relative flex flex-col gap-1 sm:pointer-events-auto">
								{chips.map((chip) => (
									<ChipEvento
										evento={chip.evento}
										estado={chip.estado}
										primerDia={chip.primerDia}
									/>
								))}
								{restantes > 0 && (
									<span class="px-1 text-[11px] text-base-content/60">+{restantes}</span>
								)}
							</div>

							{/* El modal clona esta plantilla: los eventos en grande y como enlaces */}
							{conEventos && (
								<template class="plantilla-dia">
									{celda.eventos.map(({ evento, estado, primerDia }) => (
										<li
											data-tipo={evento.tipo}
											data-inicio={evento.fechaInicio.toISOString()}
											data-fin={evento.fechaFin?.toISOString()}
										>
											<a
												href={`/eventos/${evento.slug}`}
												class="flex items-start gap-3 rounded-xl border border-base-content/10 bg-base-200/50 p-3 transition-colors hover:border-primary/50"
											>
												<span
													class={`mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full ${TIPOS_EVENTO[evento.tipo].punto}`}
												/>
												<span class="min-w-0 flex-1">
													<span class="block text-sm leading-snug font-semibold text-base-content">
														{evento.titulo}
													</span>
													<span class="mt-0.5 block text-xs text-base-content/60">
														{primerDia
															? formatearRangoFechas(evento.fechaInicio, evento.fechaFin)
															: 'continúa'}
													</span>
													<span
														class="badge-estado mt-1.5 badge border-0 badge-sm"
														data-estado={estado}
													>
														{ESTADOS_EVENTO[estado].label}
													</span>
												</span>
												<ArrowRight class="mt-0.5 h-4 w-4 shrink-0 text-base-content/30" />
											</a>
										</li>
									))}
								</template>
							)}
						</div>
					);
				})
			}
		</div>
	</div>
</section>
