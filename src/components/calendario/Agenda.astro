---
import type { GrupoMes } from '@/utils/calendario';
import TarjetaEvento from './TarjetaEvento.astro';

type Props = {
	grupos: GrupoMes[];
	oculto?: boolean;
};

const { grupos, oculto = false } = Astro.props;
/*
 * Los meses sin eventos visibles se ocultan enteros con data-mes-sin-eventos, asi que
 * no hace falta un estado vacio por mes: el que importa es el general, en calendario.
 */
---

<div id="vista-agenda" class="flex flex-col gap-10" hidden={oculto}>
	{
		grupos.map(({ mes, items }) => (
			<section class="mes-agenda" data-mes-nombre={mes}>
				<h2 class="sticky top-16 z-10 mb-4 border-b border-base-content/10 bg-base-100/90 py-2 font-heading text-2xl font-bold text-base-content backdrop-blur">
					{mes}
				</h2>
				<ul class="flex flex-col gap-4">
					{items.map(({ evento, estado }) => (
						<TarjetaEvento evento={evento} estado={estado} />
					))}
				</ul>
			</section>
		))
	}
</div>
