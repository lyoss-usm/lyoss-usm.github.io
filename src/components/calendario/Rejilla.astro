---
import type { MesCalendario } from '@/utils/calendario';
import MesRejilla from './MesRejilla.astro';
import ModalDia from './ModalDia.astro';

type Props = {
	meses: MesCalendario[];
	oculto?: boolean;
};

const { meses, oculto = false } = Astro.props;
---

<div id="vista-rejilla" class="hidden" hidden={oculto}>
	{meses.map((mes, indice) => <MesRejilla mes={mes} indice={indice} />)}
	<ModalDia />
</div>
