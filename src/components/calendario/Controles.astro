---
import { History } from '@lucide/astro';
import { TIPOS_EVENTO, type TipoEvento } from '@/utils/eventos';

type Props = {
	// Solo los tipos que tienen eventos, para no mostrar filtros vacios
	tipos: TipoEvento[];
};

const { tipos } = Astro.props;
---

<div
	class="mb-8 flex flex-col gap-4 rounded-2xl border border-base-content/10 bg-base-200/50 p-4 lg:flex-row lg:items-center lg:justify-between"
>
	<div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filtrar por tipo">
		<button
			class="filtro-tipo btn btn-sm btn-primary"
			data-tipo="todos"
			data-clase="btn-primary"
			aria-pressed="true"
		>
			Todos
		</button>
		{
			tipos.map((tipo) => (
				<button
					class="filtro-tipo btn btn-outline btn-sm"
					data-tipo={tipo}
					data-clase={TIPOS_EVENTO[tipo].boton}
					aria-pressed="false"
				>
					<span class={`inline-block h-2 w-2 rounded-full ${TIPOS_EVENTO[tipo].punto}`} />
					{TIPOS_EVENTO[tipo].label}
				</button>
			))
		}
	</div>

	<span class="h-px w-full shrink-0 bg-base-content/10 lg:hidden" aria-hidden="true"></span>

	<div class="flex flex-wrap items-center gap-3 self-start">
		<!-- Por defecto se ven solo los eventos que no pasaron; el boton destapa el historial -->
		<button
			class="ver-historial btn btn-outline btn-sm"
			data-ver-historial
			aria-pressed="false"
			aria-controls="vista-agenda"
		>
			<History class="h-4 w-4" aria-hidden="true" />
			<span data-historial-etiqueta>Ver todo el historial</span>
			<span class="badge badge-sm" data-historial-cantidad>0</span>
		</button>

		<!-- Control segmentado: un solo borde con una línea divisoria entre las dos vistas -->
		<div
			class="inline-flex items-center overflow-hidden rounded-lg border border-base-content/20"
			role="group"
			aria-label="Cambiar de vista"
		>
			<button
				class="cambiar-vista btn rounded-none border-0 btn-sm btn-primary"
				data-vista="agenda"
				aria-pressed="true"
			>
				Agenda
			</button>
			<span class="w-px self-stretch bg-base-content/20" aria-hidden="true"></span>
			<button
				class="cambiar-vista btn rounded-none border-0 btn-outline btn-sm"
				data-vista="rejilla"
				aria-pressed="false"
			>
				Mes
			</button>
		</div>
	</div>
</div>
