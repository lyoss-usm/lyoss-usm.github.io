---
import { getCollection } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import { ESTADOS_EVENTO, aEvento, calcularEstado, formatearDiaMes } from '@/utils/eventos';

const destacados = (await getCollection('eventos', ({ data }) => data.destacado))
	.map(aEvento)
	.map((evento) => ({ evento, estado: calcularEstado(evento.fechaInicio, evento.fechaFin) }))
	.filter(({ estado }) => estado !== 'finalizado')
	.sort((a, b) => a.evento.fechaInicio.getTime() - b.evento.fechaInicio.getTime());

const destacado = destacados.at(0) ?? null;
---

{
	destacado && (
		<div class="toast toast-end toast-bottom z-50 mr-2 mb-4 sm:mr-6 sm:mb-6">
			<a
				href={`/eventos/${destacado.evento.slug}`}
				class="group inline-flex max-w-[min(26rem,calc(100vw-1.5rem))] items-center gap-3 rounded-full border border-base-content/15 bg-base-200 py-2 pr-4 pl-3 shadow-lg transition-colors hover:border-primary/50 hover:bg-base-300/40"
				data-alerta-evento
				data-inicio={destacado.evento.fechaInicio.toISOString()}
				data-fin={destacado.evento.fechaFin?.toISOString()}
				data-umami-event="home-alerta-destacado"
			>
				<span
					class={`badge-estado badge border-0 badge-sm ${ESTADOS_EVENTO[destacado.estado].badge}`}
					data-estado={destacado.estado}
				>
					{ESTADOS_EVENTO[destacado.estado].label}
				</span>

				<span class="min-w-0 flex-1 truncate text-sm font-semibold text-base-content">
					{destacado.evento.titulo}
				</span>

				<time
					class="shrink-0 text-sm text-base-content/60"
					datetime={destacado.evento.fechaInicio.toISOString()}
				>
					{formatearDiaMes(destacado.evento.fechaInicio)}
				</time>

				<ArrowRight
					class="h-4 w-4 shrink-0 text-base-content/40 transition-transform group-hover:translate-x-0.5"
					aria-hidden="true"
				/>
			</a>
		</div>
	)
}

<script>
	import { ESTADOS_EVENTO, calcularEstado } from '@/utils/eventos';

	/*
	 * El build decide si el aviso se muestra, pero un sitio estatico puede quedar
	 * publicado con el evento ya terminado. Si al cargar ya vencio, el aviso se
	 * retira para no seguir anunciando algo que ya paso.
	 */
	const alerta = document.querySelector<HTMLElement>('[data-alerta-evento]');
	const inicio = alerta?.dataset.inicio;
	if (alerta && inicio) {
		const estado = calcularEstado(
			new Date(inicio),
			alerta.dataset.fin ? new Date(alerta.dataset.fin) : undefined
		);
		if (estado === 'finalizado') {
			alerta.remove();
		} else {
			// Y el badge se repinta con la fecha de quien visita
			const badge = alerta.querySelector<HTMLElement>('[data-estado]');
			if (badge) {
				Object.values(ESTADOS_EVENTO).forEach((otro) => badge.classList.remove(otro.badge));
				badge.classList.add(ESTADOS_EVENTO[estado].badge);
				badge.textContent = ESTADOS_EVENTO[estado].label;
			}
		}
	}
</script>
